        <mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person] новый клиент или клиент интернет-банка&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="230" height="90" as="geometry"/></mxCell>
