      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bExp" value="&lt;b&gt;Rates Export Service [Container: Java Spring Boot, новый]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=#666666;fontColor=#444444;fontSize=13;align=left;verticalAlign=top;spacing=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="760" height="380" as="geometry"/></mxCell>
        <mxCell id="bCC" value="&lt;b&gt;Система кол-центра банка — модуль ставок [Container: Java Spring Boot, React, доработка]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=#666666;fontColor=#444444;fontSize=13;align=left;verticalAlign=top;spacing=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="380" y="30" width="760" height="290" as="geometry"/></mxCell>
        <mxCell id="abs" value="&lt;b&gt;АБС: модуль ставок&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Oracle, PL/SQL] утверждённые ставки, outbox&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="220" height="100" as="geometry"/></mxCell>
