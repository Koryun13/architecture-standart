<mxfile host="app.diagrams.net" type="device">
  <diagram id="d1" name="Схема интеграции приложений (as-is)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;в основном старшего возраста&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="site" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PHP, React.js; только маркетинговая информация&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="ib" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ASP.NET MVC 4.5, .NET 4.5, MS SQL; монолит на платформе подрядчика; 1 ЦОД + резервный&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="front" value="&lt;b&gt;Сотрудник отделения&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;фронт-офис&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="ccop" value="&lt;b&gt;Оператор кол-центра банка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="pcop" value="&lt;b&gt;Оператор партнёрского кол-центра&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="780" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="mail" value="&lt;b&gt;Корпоративная почта + Excel-файлы ставок&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ручной канал: ставки, запросы и ответы по ставкам&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="390" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="cc" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;платформа подрядчика (CRM): React.js, Java Spring Boot, PostgreSQL, микросервисы&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="590" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="pcc" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;внешняя система&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="775" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="abs" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Delphi (десктоп-клиент), Oracle, логика на PL/SQL; учёт операций по счетам, бухгалтерия; только вертикальное масштабирование&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="dep" value="&lt;b&gt;Менеджер депозитов&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;бэк-офис депозитов&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="cred" value="&lt;b&gt;Сотрудник кредитования&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;бэк-офис кредитов&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="biz" value="&lt;b&gt;Бизнес-представители банка&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="780" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="sms" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;поддерживается IT-отделом банка&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1380" y="190" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="tel" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;внешний&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8c8c8c;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1380" y="40" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="pr" value="&lt;b&gt;Проблемы текущего процесса открытия депозита&lt;/b&gt;&lt;br&gt;1. Ставки ведутся только в Excel и передаются по почте раз в день; спецставки согласуются письмами между фронт-офисом, бэк-офисом депозитов и отделом кредитования (до 1 часа).&lt;br&gt;2. Заявку на депозит можно подать только в отделении; интернет-банк и сайт не участвуют в продаже депозитов.&lt;br&gt;3. Интернет-банк интегрирован напрямую с БД АБС (красная линия) — сильная связность, нагрузка на перегруженную БД АБС.&lt;br&gt;4. Каждая заявка требует ручной работы бэк-офиса; у кол-центров нет доступа к актуальным ставкам." style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1540" height="105" as="geometry"/></mxCell>
        <mxCell id="e0" value="маркетинговая&lt;br&gt;информация" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="site"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="80"/></Array></mxGeometry></mxCell>
        <mxCell id="e1" value="платежи, открытие&lt;br&gt;текущих счетов" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="ib"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="прямая интеграция&lt;br&gt;с БД АБС (SQL)" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#d0021b;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="ib" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="визит: заявка&lt;br&gt;на депозит" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="front"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="звонок: условия&lt;br&gt;депозита" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="ccop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="звонок" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="pcop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="заводит обращение" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ccop" target="cc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="передача обращения" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cc" target="abs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="640"/><mxPoint x="945" y="330"/><mxPoint x="1060" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="работа по скриптам" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pcop" target="pcc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="скрипты звонков&lt;br&gt;(файлы)" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="biz" target="pcc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="обработка заявки,&lt;br&gt;указание ставки" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dep" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="СМС о ставке" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="abs" target="sms"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sms" target="tel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="СМС клиенту" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tel" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="15"/><mxPoint x="125" y="15"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="создание депозита,&lt;br&gt;загрузка документов" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="front" target="abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="запрос / ответ&lt;br&gt;по ставке" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#b07d00;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="front" target="mail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="Excel-ставки&lt;br&gt;ежедневно, письма" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#b07d00;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="mail" target="dep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="расчёт ставок (Excel),&lt;br&gt;данные для спецставок" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#b07d00;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="cred" target="mail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="анализ кредитного&lt;br&gt;риска" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cred" target="abs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="610"/><mxPoint x="1300" y="280"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
